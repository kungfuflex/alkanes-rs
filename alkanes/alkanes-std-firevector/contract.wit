package alkanes:firevector;

/// FIREVECTOR — the DIESEL emission-weighting VM, addressable at 12:0.
///
/// `mode` selects how weights become payouts, and thereby which fact loads are
/// legal: 0 = split (weights come from a pre-execution scan of the block, so the
/// block total is known and emission is divided by it), 1 = rate (weights come
/// from the claim's own execution, so realized incoming amounts are readable but
/// no block total can exist).
///
/// Programs are flat `list<u64>` — widened to `Vec<u128>` by the cellpack ABI,
/// which is the machine's native word.
///
/// Weight vectors come back as `list<u8>`: little-endian u128 per weight, the
/// same packed-struct convention the rest of the system uses.
interface firevector {
    /// `sigil` is the alkane whose possession authorises set-weightmap.
    /// Set here and never settable again — a mutable setter would leave a window
    /// in which anyone could claim the capability.
    initialize: func(sigil-block: u64, sigil-tx: u64) -> result<_, string>;

    /// Evaluate a program over a whole item table in one pass. This is the shape
    /// the indexer preamble uses — one call per block, never one per item.
    evaluate: func(mode: u64, program: list<u64>, items: list<u64>) -> result<list<u8>, string>;

    /// Weight for a single item. This is what a wallet calls to show a user the
    /// weight a transaction will earn before broadcasting it.
    simulate: func(mode: u64, program: list<u64>, item: list<u64>) -> result<list<u8>, string>;

    /// Render a program as readable pseudocode. The reason emission policy is
    /// auditable by voters and not only by people who read Rust.
    disassemble-program: func(program: list<u64>) -> result<string, string>;

    /// Static verdict on a program: steps-per-item if valid, else an error
    /// naming the offending word. Governance should call this before a vote.
    validate-program: func(mode: u64, program: list<u64>) -> result<string, string>;

    /// Install a new weightmap. Gated on possession of the governance sigil,
    /// which must arrive in `incoming_alkanes`.
    ///
    /// Takes the whole policy, not just the program: `mode` decides whether a
    /// program is legal at all, so storing them separately would admit a torn
    /// write in which the stored program does not validate against the stored
    /// mode. `qualifier-*` names the prior action a mint must follow to earn
    /// anything, with `has-qualifier` = 0 meaning every mint qualifies.
    /// `rate-floor` is the virtual denominator used in rate mode and ignored in
    /// split mode.
    ///
    /// Rejects a program that does not validate, one that weighs nothing at all,
    /// a rate weightmap with a zero rate-floor, and a split program that returns
    /// a value above 1 (split settles membership, not magnitude).
    set-weightmap: func(
        mode: u64,
        has-qualifier: u64,
        qualifier-block: u64,
        qualifier-tx: u64,
        qualifier-opcode: u64,
        rate-floor: u64,
        treasury-bps: u64,
        program: list<u64>,
    ) -> result<_, string>;

    /// The active weightmap blob, as stored: header words followed by program.
    get-weightmap: func() -> result<list<u8>, string>;

    /// The active weightmap's mode discriminant.
    get-weightmap-mode: func() -> result<u64, string>;

    /// The governance sigil that may call set-weightmap. Set once, at init.
    get-sigil: func() -> result<list<u8>, string>;

    get-name: func() -> result<string, string>;
    get-symbol: func() -> result<string, string>;
}

world firevector-world {
    export firevector;
}
