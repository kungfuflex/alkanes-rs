**/node_modules
reference
*.swp
*.swo
target
src/tests/std/**/*.rs
memory-bank/activeContext.md
memory-bank/progress.md
scripts/.addresses.json
.pkgenv
pkg-sa-key.json

# Reproducible build outputs from scripts/build.sh. The canonical sha256
# is tracked via dist/SHA256SUMS; the wasm bytes themselves are shipped
# to subkube's prebuilts/ rather than committed here.
dist/alkanes.wasm
.verify-a/
.verify-b/

# A cargo target directory landing inside the `alkanes/` source tree, from
# running cargo with `--target-dir alkanes`. Nothing in the repo does this on
# purpose — `scripts/build-std.sh` targets `target/build-std`, which the bare
# `target` entry above already covers — so these are guards against a stray
# invocation rather than an expected output location. Anchored to `alkanes/`
# and named individually because that directory also holds real crates.
/alkanes/.rustc_info.json
/alkanes/.cargo-lock
/alkanes/CACHEDIR.TAG
/alkanes/debug/
/alkanes/release/
/alkanes/wasm32-unknown-unknown/
